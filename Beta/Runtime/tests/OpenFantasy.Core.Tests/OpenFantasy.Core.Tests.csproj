<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/OpenFantasy.Core/OpenFantasy.Core.csproj" />
    <None Update="Fixtures/reference-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/commands-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/packages-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/custody-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/scheduling-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/history-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/custody-invalid-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/exposure-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/production-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/production-ledger-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/world-production-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/actors-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/observations-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/language-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/authority-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/terrain-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/world-actions-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/world-receipts-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/gathering-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Progression/progression-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Quests/quest-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Construction/construction-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
